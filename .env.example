# Copy to .env and fill in. .env is gitignored.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

DATABASE_URL=postgres://localhost/ieltsmock

# Comma separated. The SPA origin(s) allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Vercel preview deploys get random hostnames; match them with a regex.
CORS_ALLOWED_ORIGIN_REGEXES=

# --- production only ---
# DJANGO_ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# REDIS_URL=redis://127.0.0.1:6379/0
# SENTRY_DSN=

# Set to False only while the droplet is reachable by IP and has no certificate.
# It disables the https redirect and the Secure flag on both cookies; with it
# left True on a plain-http host every request redirect-loops.
# DJANGO_SECURE_SSL=True

# HSTS, separately, because it is the one setting here that cannot be undone:
# a browser that has seen the header refuses plain http for the full duration.
# An IP certificate lives 160 hours, so IP deploys pin this to 0 and only raise
# it once the API answers on a hostname.
# DJANGO_HSTS_SECONDS=0
